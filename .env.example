# Public analytics (appear in HTML — not secrets).
# Copy to `.env` for local builds. Leave empty to skip loading trackers.

# GA4 web stream for ksctower.com (optional; leave empty until a dedicated property exists)
PUBLIC_GA_MEASUREMENT_ID=

# Shared PostHog project (same token as other public Funi Labs sites)
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
