{
	"name": "ksc-tower",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"routes": [
		{ "pattern": "ksctower.com", "custom_domain": true },
		{ "pattern": "www.ksctower.com", "custom_domain": true }
	]
}
