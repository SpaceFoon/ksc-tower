---
import HeaderLink from './HeaderLink.astro';
import { BRAND } from '../consts';
---

<header class="site-header">
	<div class="shell site-header__inner">
		<a class="brand" href="/">
			<svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true">
				<rect width="64" height="64" rx="10" fill="#14202B"></rect>
				<circle cx="32" cy="34" r="18" stroke="#3A9BB5" stroke-width="2" fill="none" opacity="0.9"></circle>
				<circle cx="32" cy="34" r="11" stroke="#3A9BB5" stroke-width="1.5" fill="none" opacity="0.55"></circle>
				<circle cx="32" cy="34" r="4" fill="#E86A17"></circle>
				<path d="M32 16v36M14 34h36" stroke="#3A9BB5" stroke-width="1" opacity="0.45"></path>
				<path d="M32 34 L46 20" stroke="#E86A17" stroke-width="2" stroke-linecap="round"></path>
				<rect x="20" y="8" width="24" height="6" rx="1" fill="#E8EEF2"></rect>
				<rect x="28" y="4" width="8" height="5" rx="1" fill="#E86A17"></rect>
			</svg>
			<span class="brand__text">{BRAND}</span>
		</a>
		<nav class="nav" aria-label="Primary">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/how-it-works">How it works</HeaderLink>
			<HeaderLink href="/get-started">Get started</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
	</div>
</header>
