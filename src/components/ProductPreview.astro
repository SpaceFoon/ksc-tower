---
---

<figure class="product-demo" id="tower-screen" aria-labelledby="product-demo-title">
	<div class="product-demo__heading">
		<div>
			<p class="product-demo__eyebrow">Actual product screens</p>
			<h3 class="product-demo__title" id="product-demo-title">Inside the tower network</h3>
		</div>
		<p class="product-demo__sample">Sample data · not a live KSP session</p>
	</div>
	<div class="product-demo__screens">
		<article class="product-screen product-screen--featured">
			<header class="product-screen__heading">
				<h4 class="product-screen__title">Flightwall</h4>
				<p>Controller radar and flight details</p>
			</header>
			<div class="product-demo__frame">
				<iframe
					src="/product-preview/flightwall-preview.html"
					title="KSC Tower flightwall with sample aircraft and flight details"
					loading="lazy"
				></iframe>
			</div>
		</article>
		<article class="product-screen">
			<header class="product-screen__heading">
				<h4 class="product-screen__title">Kerbin tower map</h4>
				<p>Traffic plotted on the actual tower map</p>
			</header>
			<div class="product-demo__frame">
				<iframe
					src="/product-preview/kerbin-map-preview.html"
					title="KSC Tower Kerbin map showing sample traffic"
					loading="lazy"
				></iframe>
			</div>
		</article>
		<article class="product-screen">
			<header class="product-screen__heading">
				<h4 class="product-screen__title">Kerbol system schematic</h4>
				<p>Product system map with sample orbital markers</p>
			</header>
			<div class="product-demo__frame">
				<iframe
					src="/product-preview/system-map-preview.html"
					title="KSC Tower Kerbol system schematic with sample orbital markers"
					loading="lazy"
				></iframe>
			</div>
		</article>
	</div>
	<figcaption class="product-demo__caption">
		All three views render the shipped KSCTower web-app components. Traffic and orbit markers use sample data; no live KSP session is connected.
	</figcaption>
</figure>
