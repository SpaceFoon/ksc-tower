---
/**
 * Full-bleed stylized tower scope — decorative hero plane, not a card.
 */
---

<div class="hero__visual" aria-hidden="true">
	<svg class="scope" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice">
		<defs>
			<radialGradient id="scopeGlow" cx="62%" cy="48%" r="45%">
				<stop offset="0%" stop-color="#ffffff" stop-opacity="0.35"></stop>
				<stop offset="55%" stop-color="#3a9bb5" stop-opacity="0.18"></stop>
				<stop offset="100%" stop-color="#6aa9c9" stop-opacity="0"></stop>
			</radialGradient>
			<linearGradient id="runway" x1="0" y1="0" x2="1" y2="0">
				<stop offset="0%" stop-color="#14202b" stop-opacity="0"></stop>
				<stop offset="35%" stop-color="#14202b" stop-opacity="0.45"></stop>
				<stop offset="65%" stop-color="#14202b" stop-opacity="0.45"></stop>
				<stop offset="100%" stop-color="#14202b" stop-opacity="0"></stop>
			</linearGradient>
			<filter id="blipGlow" x="-120%" y="-120%" width="340%" height="340%">
				<feGaussianBlur in="SourceGraphic" stdDeviation="3.8" result="blur"></feGaussianBlur>
				<feMerge>
					<feMergeNode in="blur"></feMergeNode>
					<feMergeNode in="blur"></feMergeNode>
					<feMergeNode in="SourceGraphic"></feMergeNode>
				</feMerge>
			</filter>
		</defs>

		<rect width="1200" height="800" fill="url(#scopeGlow)"></rect>

		<!-- distant hills -->
		<path
			d="M0 520 C180 470 260 560 420 510 C560 470 640 540 780 500 C940 450 1040 530 1200 490 L1200 800 L0 800 Z"
			fill="#8fb09a"
			opacity="0.35"></path>
		<path
			d="M0 580 C220 540 320 610 480 570 C650 525 760 600 920 560 C1040 530 1120 580 1200 560 L1200 800 L0 800 Z"
			fill="#6f947c"
			opacity="0.28"></path>

		<!-- scope rings -->
		<g transform="translate(740 360)" fill="none" stroke="#14202b" stroke-opacity="0.22">
			<circle r="70" stroke-width="1.5"></circle>
			<circle r="140" stroke-width="1.5"></circle>
			<circle r="210" stroke-width="1.5"></circle>
			<circle r="280" stroke-width="1.5"></circle>
			<!-- Spokes end on the outer ring (r=280); diagonals at 280/√2 ≈ 198 -->
			<path d="M0 -280 V280 M-280 0 H280" stroke-width="1"></path>
			<path d="M-198 -198 L198 198 M198 -198 L-198 198" stroke-width="1" opacity="0.7"></path>
			<!-- Beam along +X; CSS rotates around local origin. Outer tip sits on r=280; wake is a true arc (~34°). -->
			<g class="scope__beam">
				<path
					d="M0 0 L280 0 A280 280 0 0 0 232.12 -156.64 Z"
					fill="#e86a17"
					fill-opacity="0.28"
					stroke="none"></path>
				<path
					d="M0 0 L280 0"
					stroke="#e86a17"
					stroke-width="2.5"
					stroke-opacity="0.75"
					stroke-linecap="butt"></path>
			</g>
			<circle class="scope__blip" cx="160" cy="-90" r="6" fill="#e86a17" filter="url(#blipGlow)"></circle>
			<circle class="scope__blip scope__blip--late" cx="-120" cy="70" r="5" fill="#1f7f8f" filter="url(#blipGlow)"></circle>
			<circle class="scope__blip" cx="40" cy="150" r="4.5" fill="#14202b" opacity="0.55" filter="url(#blipGlow)"></circle>
		</g>

		<!-- runway strip -->
		<g transform="translate(80 620)">
			<rect width="520" height="34" fill="url(#runway)"></rect>
			<g fill="#e8eef2" opacity="0.85">
				<rect x="40" y="14" width="36" height="6"></rect>
				<rect x="100" y="14" width="36" height="6"></rect>
				<rect x="160" y="14" width="36" height="6"></rect>
				<rect x="220" y="14" width="36" height="6"></rect>
				<rect x="280" y="14" width="36" height="6"></rect>
				<rect x="340" y="14" width="36" height="6"></rect>
				<rect x="400" y="14" width="36" height="6"></rect>
			</g>
		</g>

		<!-- ATC tower — matches classic cab: flat roof, flared panes, walkway, slim shaft -->
		<g transform="translate(168 230)">
			<g fill="#14202b" opacity="0.58">
				<!-- flat roof fascia (widest point, slight overhang) -->
				<rect x="4" y="20" width="104" height="12"></rect>
				<!-- outward-sloping cab shell -->
				<path d="M12 32 L28 88 H84 L100 32 Z"></path>
				<!-- exterior walkway / sill under glass -->
				<rect x="22" y="88" width="68" height="10"></rect>
				<!-- simple railing posts on walkway -->
				<rect x="26" y="84" width="2" height="6"></rect>
				<rect x="40" y="84" width="2" height="6"></rect>
				<rect x="54" y="84" width="2" height="6"></rect>
				<rect x="68" y="84" width="2" height="6"></rect>
				<rect x="82" y="84" width="2" height="6"></rect>
				<!-- slim shaft -->
				<rect x="46" y="98" width="20" height="222"></rect>
				<!-- podium -->
				<rect x="36" y="312" width="40" height="22"></rect>
				<rect x="26" y="330" width="60" height="14"></rect>
			</g>
			<!-- one band of tall floor-to-ceiling panes (mullioned) -->
			<g fill="#b7d4e0" opacity="0.9">
				<path d="M20 36 L30 82 H40 L32 36 Z"></path>
				<path d="M36 36 L44 82 H56 L48 36 Z"></path>
				<path d="M52 36 L60 82 H72 L64 36 Z"></path>
				<path d="M68 36 L76 82 H86 L80 36 Z"></path>
			</g>
		</g>

		<!-- plane on runway traffic pattern -->
		<g class="scope__plane" fill="#14202b" opacity="0.72">
			<!-- fuselage -->
			<path d="M0 0 L38 2 L52 0 L38 -2 Z"></path>
			<!-- main wing -->
			<path d="M18 -1 L28 -14 L34 -14 L26 1 L34 14 L28 14 Z"></path>
			<!-- tail -->
			<path d="M2 -1 L8 -9 L12 -9 L6 0 L12 8 L8 8 Z"></path>
			<!-- cockpit glint -->
			<circle cx="42" cy="0" r="1.6" fill="#e8eef2" opacity="0.55"></circle>
		</g>

		<!-- heli orbiting near tower / pattern -->
		<g class="scope__heli" fill="#14202b" opacity="0.68">
			<!-- cabin -->
			<path d="M8 -6 C14 -10 26 -10 30 -4 L32 4 C28 9 14 9 8 5 C4 3 4 -2 8 -6 Z"></path>
			<!-- boom -->
			<path d="M8 0 L-18 1 L-20 -1 L8 -2 Z"></path>
			<!-- tail fin -->
			<path d="M-18 0 L-22 -8 L-16 -1 Z"></path>
			<!-- skids -->
			<path
				d="M12 8 L12 12 M26 8 L26 12 M10 12 H28"
				fill="none"
				stroke="#14202b"
				stroke-width="1.4"
				stroke-linecap="round"></path>
			<!-- main rotor (hub at 20,-8) -->
			<g transform="translate(20 -8)">
				<line x1="0" y1="0" x2="0" y2="-3" stroke="#14202b" stroke-width="1.5"></line>
				<g class="scope__rotor">
					<path d="M-26 -3 H26" stroke="#14202b" stroke-width="2" stroke-linecap="round" opacity="0.85"></path>
					<path d="M-20 -1 H20" stroke="#14202b" stroke-width="1.2" stroke-linecap="round" opacity="0.35"></path>
				</g>
			</g>
			<!-- tail rotor (hub at -20,-4) -->
			<g transform="translate(-20 -4)">
				<line x1="0" y1="3" x2="0" y2="-3" stroke="#14202b" stroke-width="1.2"></line>
				<g class="scope__tail-rotor">
					<path d="M0 -6 V6" stroke="#14202b" stroke-width="1.5" stroke-linecap="round" opacity="0.7"></path>
				</g>
			</g>
		</g>

		<!-- far-right pad + launch plume + rocket (CSS places smoke/rocket at x≈1020) -->
		<g class="scope__launch">
			<!-- ground pad / umbilical -->
			<g transform="translate(1020 0)" fill="#14202b" opacity="0.45">
				<rect x="-28" y="635" width="56" height="10"></rect>
				<rect x="-8" y="580" width="6" height="55"></rect>
				<rect x="12" y="560" width="5" height="75"></rect>
				<path d="M14 560 H28 L24 575 H14 Z"></path>
			</g>

			<!-- soft outer haze -->
			<g class="scope__smoke-haze" fill="#8fa0ae">
				<ellipse cx="0" cy="0" rx="130" ry="56" opacity="0.35"></ellipse>
				<ellipse cx="-48" cy="18" rx="110" ry="44" opacity="0.3"></ellipse>
				<ellipse cx="50" cy="16" rx="115" ry="46" opacity="0.3"></ellipse>
			</g>

			<!-- big billowing ground smoke -->
			<g class="scope__smoke" fill="#6d7f8d">
				<ellipse class="scope__smoke-puff scope__smoke-puff--a" cx="0" cy="0" rx="48" ry="30" opacity="0.55" style="--puff-x: 8px;"></ellipse>
				<ellipse class="scope__smoke-puff scope__smoke-puff--b" cx="-52" cy="-10" rx="62" ry="36" opacity="0.5" style="--puff-x: -32px;"></ellipse>
				<ellipse class="scope__smoke-puff scope__smoke-puff--c" cx="56" cy="-6" rx="66" ry="38" opacity="0.48" style="--puff-x: 40px;"></ellipse>
				<ellipse class="scope__smoke-puff scope__smoke-puff--d" cx="-16" cy="-32" rx="82" ry="46" opacity="0.42" style="--puff-x: -14px;"></ellipse>
				<ellipse class="scope__smoke-puff scope__smoke-puff--e" cx="38" cy="-42" rx="88" ry="50" opacity="0.4" style="--puff-x: 26px;"></ellipse>
				<ellipse class="scope__smoke-puff scope__smoke-puff--f" cx="-68" cy="-16" rx="72" ry="42" opacity="0.45" style="--puff-x: -48px;"></ellipse>
				<ellipse class="scope__smoke-puff scope__smoke-puff--g" cx="84" cy="-12" rx="56" ry="34" opacity="0.48" style="--puff-x: 54px;"></ellipse>
				<ellipse class="scope__smoke-puff scope__smoke-puff--h" cx="10" cy="-58" rx="100" ry="56" opacity="0.32" style="--puff-x: 12px;"></ellipse>
				<ellipse class="scope__smoke-puff scope__smoke-puff--i" cx="-30" cy="-70" rx="70" ry="40" opacity="0.28" style="--puff-x: -20px;"></ellipse>
			</g>

			<!-- brighter core cloud for contrast -->
			<g class="scope__smoke-core" fill="#b7c4ce">
				<ellipse cx="-20" cy="-20" rx="55" ry="34" opacity="0.55"></ellipse>
				<ellipse cx="28" cy="-28" rx="60" ry="36" opacity="0.5"></ellipse>
				<ellipse cx="4" cy="-48" rx="72" ry="40" opacity="0.4"></ellipse>
			</g>

			<!-- exhaust column -->
			<g class="scope__exhaust" fill="#9aabbb">
				<ellipse cx="0" cy="0" rx="18" ry="40" opacity="0.55"></ellipse>
				<ellipse cx="2" cy="-44" rx="14" ry="42" opacity="0.45"></ellipse>
				<ellipse cx="-2" cy="-88" rx="13" ry="40" opacity="0.35"></ellipse>
				<ellipse cx="1" cy="-132" rx="11" ry="38" opacity="0.28"></ellipse>
			</g>

			<!-- rocket + flame (local origin = engine) -->
			<g class="scope__rocket">
				<g fill="#14202b" opacity="0.8">
					<path d="M0 -100 L12 -78 H-12 Z"></path>
					<rect x="-12" y="-78" width="24" height="88"></rect>
					<path d="M-12 -2 L-26 20 L-12 12 Z"></path>
					<path d="M12 -2 L26 20 L12 12 Z"></path>
					<path d="M-8 10 L-13 22 H13 L8 10 Z"></path>
					<rect x="-12" y="-42" width="24" height="6" fill="#e86a17" opacity="0.9"></rect>
				</g>
				<g class="scope__flame">
					<path d="M-8 22 L0 68 L8 22 Z" fill="#e86a17" opacity="0.95"></path>
					<path d="M-4 22 L0 52 L4 22 Z" fill="#f4c27a" opacity="0.95"></path>
				</g>
			</g>
		</g>
	</svg>
</div>

<style>
	.scope {
		width: 100%;
		height: 100%;
		display: block;
	}

	.scope__beam {
		/* fill-box + bottom-left = local (0,0) while the wake sits in y <= 0 */
		transform-box: fill-box;
		transform-origin: 0% 100%;
		animation: sweep 9s linear infinite;
	}

	.scope__blip {
		transform-box: fill-box;
		transform-origin: center;
		animation: pulse-blip 1.7s ease-in-out infinite;
	}

	.scope__blip--late {
		animation-delay: 1.1s;
	}

	.scope__plane {
		animation: plane-circuit 22s linear infinite;
	}

	.scope__heli {
		animation: heli-orbit 16s ease-in-out infinite;
	}

	.scope__rotor,
	.scope__tail-rotor {
		transform-box: fill-box;
		transform-origin: center;
	}

	.scope__rotor {
		animation: rotor-spin 0.18s linear infinite;
	}

	.scope__tail-rotor {
		animation: rotor-spin 0.12s linear infinite;
	}

	.scope__rocket {
		transform-box: view-box;
		transform-origin: 0 0;
		animation: rocket-ascent 14s ease-in infinite;
	}

	.scope__flame {
		transform-box: fill-box;
		transform-origin: top center;
		animation:
			flame-flicker 0.18s ease-in-out infinite alternate,
			flame-gate 14s ease-in infinite;
	}

	.scope__smoke,
	.scope__smoke-haze,
	.scope__smoke-core,
	.scope__exhaust {
		transform-box: view-box;
		transform-origin: 0 0;
	}

	.scope__smoke {
		animation: smoke-bloom 14s ease-out infinite;
	}

	.scope__smoke-haze {
		animation: smoke-haze 14s ease-out infinite;
	}

	.scope__smoke-core {
		animation: smoke-bloom 14s ease-out infinite;
		animation-delay: 0.05s;
	}

	.scope__exhaust {
		animation: exhaust-column 14s ease-in infinite;
	}

	.scope__smoke-puff--a {
		animation: puff-drift 14s ease-out infinite;
	}
	.scope__smoke-puff--b {
		animation: puff-drift 14s ease-out infinite;
		animation-delay: 0.15s;
	}
	.scope__smoke-puff--c {
		animation: puff-drift 14s ease-out infinite;
		animation-delay: 0.08s;
	}
	.scope__smoke-puff--d {
		animation: puff-drift 14s ease-out infinite;
		animation-delay: 0.22s;
	}
	.scope__smoke-puff--e {
		animation: puff-drift 14s ease-out infinite;
		animation-delay: 0.3s;
	}
	.scope__smoke-puff--f {
		animation: puff-drift 14s ease-out infinite;
		animation-delay: 0.12s;
	}
	.scope__smoke-puff--g {
		animation: puff-drift 14s ease-out infinite;
		animation-delay: 0.18s;
	}
	.scope__smoke-puff--h {
		animation: puff-drift 14s ease-out infinite;
		animation-delay: 0.25s;
	}
	.scope__smoke-puff--i {
		animation: puff-drift 14s ease-out infinite;
		animation-delay: 0.28s;
	}
</style>
