---
import { BRAND, FUNI_URL, GITHUB_SITE, ORG } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell site-footer__inner">
		<div>
			<div class="site-footer__brand">{BRAND}</div>
			<p>
				&copy; {year}
				<a href={FUNI_URL}>{ORG}</a>. Built for Kerbal Space Program communities.
			</p>
		</div>
		<div class="footer-links">
			<a href="/how-it-works">How it works</a>
			<a href="/get-started">Get started</a>
			<a href="/about">About</a>
			<a href={GITHUB_SITE} rel="noopener noreferrer" target="_blank">Website source on GitHub</a>
		</div>
	</div>
</footer>
